	NoSources:
		'''
		Brak znanego źródła: prawdopodobnie znajduje się w skrzyniach, na rybach
		albo w świecie (niszcząc bloki, potrząsając drzewami itp.).
		'''
	MoreAbove: "{0} więcej wyżej (kółko myszy)"
	MoreBelow: "{0} więcej niżej (kółko myszy)"
	SoldBy: Sprzedaje: {0}: {1}
	SoldByFree: Sprzedaje: {0}
	DroppedBy: Wypada z: {0} ({1})
	FoundInside: W środku: {0} ({1})
	AnyEnemy: dowolnego wroga
	SpawnsIn: Występuje: {0}
	Page: Strona {0} / {1}  ({2} przedmiotów)
	Platinum: "{0} plat."
	Gold: "{0} zł."
	Silver: "{0} sr."
	Copper: "{0} mie."
	FoundIn: "{0}: znaleziono w {1} skrzyni(ach)."
	Blocks: "{0} bloków"
	RecipesButton: Przepisy
	HelpTerminal:
		'''
		Pisz w wyszukiwarce, by filtrować przedmioty (@mod filtruje według moda).
		LPM na przedmiocie: wyjmij stos (wypadnie z drzwiczek).
		Przytrzymaj PPM na przedmiocie: wybierz ilość, potem wyjmij ją LPM.
		PPM w puste miejsce: porzuć wybraną ilość.
		Shift + klik: podświetl skrzynie, w których leży.
		Ctrl + klik: jego przepisy, w indeksie obok terminala.
		Przepisy: otwórz lub zamknij indeks przepisów obok terminala.
		Odłóż wszystko: twój ekwipunek trafia do skrzyń
		(poza paskiem szybkiego dostępu, monetami, amunicją i ulubionymi).
		Odłóż przedmioty: miejsca, które po zamknięciu trafiają do skrzyń.
		Terminal i skrzynie muszą być na tym samym czerwonym kablu.
		Ikony nad przedmiotami: stacje rzemieślnicze na kablu; liczą się przy wytwarzaniu ze skrzyń.
		'''
	HelpIndex:
		'''
		LPM na przedmiocie: jak go wytworzyć. PPM: do czego służy.
		Kółko myszy nad przepisem: następny. Wstecz: poprzedni przedmiot.
		Składniki: zielony = w ekwipunku, niebieski = w skrzyniach terminala, czerwony = brakuje.
		Drzewo: wszystko, co potrzebne, aż do materiałów podstawowych; można je ustawić jako cel.
		Przy terminalu możesz wytwarzać prosto z jego skrzyń albo wyjąć to, czego ci brakuje.
		Klawisze (Ustawienia > Sterowanie): otwórz indeks, przepisy lub zastosowania przedmiotu pod kursorem.
		Środkowy przycisk na przedmiocie: wyjmij stos ze skrzyń terminala (blisko ostatnio otwartego).
		'''
	TipPlaced: Terminal postawiony! Połącz go ze skrzyniami czerwonym kablem (kładzie się go: {0}, sprzedaje: {1}), a potem kliknij go PPM.
	TipOpened: Wskazówka: najedź na przycisk ?, by zobaczyć sterowanie terminala. „Przepisy” otwiera obok indeks przepisów.
}

Items: {
	TerminalItem: {
		DisplayName: Terminal
		Tooltip:
			'''
			Stawia się go na ścianie w tle
			Połącz go ze skrzyniami czerwonym kablem i kliknij PPM, by szukać przedmiotów
			Wyjmowane przedmioty wypadają z jego drzwiczek
			'''
	}

	RemoteTerminalItem: {
		DisplayName: Przenośny terminal
		Tooltip:
			'''
			Trzymaj go i kliknij PPM na terminal, by je połączyć
			Użyj go, by otworzyć połączony terminal z dowolnego miejsca
			Wyjmowane przedmioty pojawiają się obok ciebie
			'''
	}

	BlueprintItem: {
		DisplayName: Plan budowy
		Tooltip:
			'''
			PPM, by wybrać dom i materiał
			LPM, by zbudować go tam, gdzie jest podgląd
			Materiały są brane z ekwipunku; stacja rzemieślnicza niepotrzebna
			'''
	}

	RadioItem: {
		DisplayName: Radio
		Tooltip:
			'''
			Co jakiś czas coś gra
			Kliknij PPM, by je włączyć lub wyłączyć
			'''
	}
}

