Keybinds: {
	ToggleBrowser.DisplayName: 打开/关闭配方索引
	ShowRecipes.DisplayName: 查看鼠标下物品的配方
	ShowUses.DisplayName: 查看鼠标下物品的用途
}

UI: {
	Title: 配方索引
	SearchHint: 搜索...（@模组名 按模组筛选）
