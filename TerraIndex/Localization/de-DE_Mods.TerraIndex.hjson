	TerminalTitle: Lagerterminal
	ConnectedChests: "Verbundene Truhen: {0}"
	WireStations: "Stationen am Draht:"
	NoWireStations: "keine (lege Handwerksstationen an den roten Draht)"
	TerminalHint: "Klick: ein Stapel   Rechtsklick halten: Menge   Umschalt: Truhe   Strg: Rezept"
	TerminalHoldingHint: "Klick auf einen Gegenstand: {0} herausnehmen   Rechtsklick ins Leere: abbrechen"
	Max: Max
	TerminalEmpty:
		'''
		Keine Gegenstände.
		Verbinde das Terminal und deine Truhen mit demselben roten Draht.
		'''
	DepositButton: Einlagern
	DepositTitle: Gegenstände in die Truhen einlagern
	DepositHint: Beim Schließen gehen die Gegenstände durch die Tür des Terminals in die Truhen.
	Done: Fertig
	DepositDone: Gegenstände in den Truhen verstaut.
	DepositNoSpace: "Achtung: Die verbundenen Truhen sind voll. {0} Gegenstand/Gegenstände wurden nicht gesendet und bleiben im Terminal, bis Platz ist oder du sie herausnimmst."
	DepositInUse: Ein anderer Spieler benutzt gerade die Einlagerungsplätze dieses Terminals.
	QuickDepositButton: Alles einlagern
	QuickDepositEmpty: Nichts einzulagern (Schnellleiste, Münzen, Munition und Favoriten bleiben).
	QuickDepositNoSpace: "Die verbundenen Truhen sind voll: {0} Gegenstand/Gegenstände wurden dir zurückgegeben."
	SortBy: "Sortieren: {0}"
	SortName: Name
	SortAmount: Menge
	SortRarity: Seltenheit
	SortMod: Mod
	RemoteLinked: Tragbares Terminal mit diesem Terminal verbunden.
	RemoteNotLinked: Nicht verbunden. Halte es und klicke mit Rechts auf ein Terminal, um sie zu verbinden.
	RemoteLinkedTo: Verbunden mit einem Terminal, {0} Blöcke entfernt
	RemoteDisabled: Das tragbare Terminal ist auf diesem Server deaktiviert.
	HowToObtain: Wie man es bekommt
	NoSources:
		'''
		Keine bekannte Quelle: Es findet sich wahrscheinlich in Truhen, beim Angeln
		oder in der Welt (Blöcke abbauen, Bäume schütteln usw.).
		'''
	MoreAbove: "{0} weitere oben (Mausrad)"
	MoreBelow: "{0} weitere unten (Mausrad)"
	SoldBy: "Verkauft von {0}: {1}"
	SoldByFree: Verkauft von {0}
	DroppedBy: Fallen gelassen von {0} ({1})
	FoundInside: In {0} ({1})
	AnyEnemy: jedem Gegner
	SpawnsIn: "Zu finden in: {0}"
	Page: Seite {0} / {1}  ({2} Gegenstände)
	Platinum: "{0} Platin"
	Gold: "{0} Gold"
	Silver: "{0} Silber"
	Copper: "{0} Kupfer"
	FoundIn: "{0}: in {1} Truhe(n) gefunden."
	Blocks: "{0} Blöcke"
	RecipesButton: Rezepte
	HelpTerminal:
		'''
		Tippe ins Suchfeld, um die Gegenstände zu filtern (@mod filtert nach Mod).
		Linksklick auf einen Gegenstand: einen Stapel herausnehmen (kommt aus der Tür).
		Rechtsklick auf einen Gegenstand halten: Menge wählen, dann mit Linksklick herausnehmen.
		Rechtsklick ins Leere: die gewählte Menge verwerfen.
		Umschalt + Klick: die Truhen aufleuchten lassen, die ihn enthalten.
		Strg + Klick: seine Rezepte, im Index neben dem Terminal.
		Rezepte: den Rezeptindex neben dem Terminal öffnen oder schließen.
		Alles einlagern: dein Inventar geht in die Truhen
		(nicht die Schnellleiste, Münzen, Munition oder Favoriten).
		Einlagern: Plätze, die beim Schließen in die Truhen gehen.
		Das Terminal und die Truhen müssen am selben roten Draht hängen.
		Die Symbole über den Gegenständen: Handwerksstationen am Draht; sie zählen beim Herstellen aus den Truhen.
		'''
	HelpIndex:
		'''
		Linksklick auf einen Gegenstand: wie man ihn herstellt. Rechtsklick: wofür er verwendet wird.
		Mausrad über einem Rezept: das nächste. Zurück: der vorherige Gegenstand.
		Zutaten: grün = im Inventar, blau = in den Truhen eines Terminals, rot = fehlt.
		Baum: alles Nötige bis zu den Grundmaterialien; er kann als Ziel gesetzt werden.
		In der Nähe eines Terminals kannst du direkt aus seinen Truhen herstellen oder nehmen, was dir fehlt.
		Tasten (Einstellungen > Steuerung): Index öffnen, Rezepte oder Verwendungen des Gegenstands unter der Maus.
		Mittelklick auf einen Gegenstand: einen Stapel aus den Truhen eines Terminals nehmen (in der Nähe des zuletzt geöffneten).
		'''
	TipPlaced: "Terminal platziert! Verbinde es mit rotem Draht mit deinen Truhen (verlegt mit: {0}, verkauft von: {1}) und klicke es dann mit Rechts an."
	TipOpened: "Tipp: Fahre mit der Maus über den ?-Knopf, um die Steuerung des Terminals zu sehen. \"Rezepte\" öffnet den Rezeptindex daneben."
}

Items: {
	TerminalItem: {
		DisplayName: Terminal
		Tooltip:
			'''
			Muss an einer Hintergrundwand platziert werden
			Verbinde es mit rotem Draht mit deinen Truhen und klicke es mit Rechts an, um Gegenstände zu suchen
			Herausgenommene Gegenstände kommen aus seiner Tür
			'''
	}

	RemoteTerminalItem: {
		DisplayName: Tragbares Terminal
		Tooltip:
			'''
			Halte es und klicke mit Rechts auf ein Terminal, um sie zu verbinden
			Benutze es, um das verbundene Terminal von überall zu öffnen
			Herausgenommene Gegenstände erscheinen neben dir
			'''
	}

	BlueprintItem: {
		DisplayName: "Bauplan"
		Tooltip:
			'''
			Rechtsklick, um ein Haus und sein Material zu wählen
			Linksklick, um es dort zu bauen, wo die Vorschau ist
			Die Materialien kommen aus deinem Inventar; keine Handwerksstation nötig
			'''
	}

	RadioItem: {
		DisplayName: Radio
		Tooltip:
			'''
			Spielt ab und zu etwas
			Rechtsklick schaltet es ein oder aus
			'''
	}
}

Tiles: {
	TerminalTile.MapEntry: Terminal
	RadioTile.MapEntry: Radio
}

Configs: {
	ClientConfig: {
		DisplayName: Terra Index (deine Einstellungen)

		Headers: {
			Goal: Herstellungsziel
			Terminal: Lagerterminal
			Effects: Effekte
		}

		ShowGoalPanel: {
			Label: Zielfenster anzeigen
			Tooltip: Die Liste auf dem Bildschirm mit den Materialien, die dir für dein Ziel noch fehlen
		}

		GoalPanelRows: {
			Label: "Zielfenster: angezeigte Materialien"
			Tooltip: Der Rest wird als "+N weitere" zusammengefasst
		}

		DefaultSort: {
			Label: Standardsortierung des Terminals
			Tooltip: Reihenfolge der Gegenstände im Terminal beim Betreten einer Welt
		}

		HighlightSeconds: {
			Label: Dauer der Truhenmarkierung (Sekunden)
			Tooltip: Wie lange Truhen leuchten, nachdem du im Terminal Umschalt + Klick auf einen Gegenstand gemacht hast
		}

		QuickDepositHotbar: {
			Label: Schnellleiste bei "Alles einlagern" einbeziehen
			Tooltip: Favoriten, Münzen und Munition bleiben immer
		}

		FocusTerminalSearch: {
			Label: "Beim Öffnen des Terminals ins Suchfeld tippen"
			Tooltip: "Während du tippst, funktionieren die Tasten des Mods (N, [ und ]) nicht"
		}

		DeliveryDrones: {
			Label: Lieferdrohnen
			Tooltip: Kleine Drohnen tragen die Gegenstände zwischen den Truhen und der Tür des Terminals (nur optisch)
		}

		ChestEffects: {
			Label: Truheneffekte
			Tooltip: Funken, Licht und ein Geräusch an den Truhen, in die Gegenstände hinein- oder aus denen sie herausgehen
		}
	}

	ServerConfig: {
		DisplayName: Terra Index (Server)

		TerminalPriceGold: {
			Label: Preis des Terminals (Gold)
			Tooltip: Was das Terminal im Laden kostet. 100 Gold = 1 Platin
		}

		TerminalReach: {
			Label: Reichweite des Terminals (Blöcke)
			Tooltip: Wie weit sich Spieler von einem Terminal entfernen können, bevor sich sein Fenster schließt
		}

		MaxWireTiles: {
			Label: Maximale Größe des Drahtnetzes
			Tooltip: Rote Drahtfelder, die von einem Terminal aus nach Truhen abgesucht werden. Verringere den Wert, wenn riesige Netze Lag verursachen
		}

		AllowPortableTerminal: {
			Label: Tragbares Terminal erlauben
			Tooltip: Wenn aus, können tragbare Terminals keine Terminals aus der Ferne öffnen
		}
	}

	TerminalSort: {
		Name: {
			Label: Name
			Tooltip: ""
		}

		Amount: {
			Label: Menge
			Tooltip: ""
		}

		Rarity: {
			Label: Seltenheit
			Tooltip: ""
		}

		Mod: {
			Label: Mod
			Tooltip: ""
		}

		Tooltip: ""
	}
}
