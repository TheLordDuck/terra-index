		}

		TerminalReach: {
			Label: Portée du terminal (blocs)
			Tooltip: Jusqu'où les joueurs peuvent s'éloigner d'un terminal avant que son panneau se ferme
		}

		MaxWireTiles: {
			Label: Taille maximale du réseau de fils
			Tooltip: Cases de fil rouge parcourues depuis un terminal pour trouver des coffres. Baisse-la si d'énormes réseaux causent du lag
		}

		AllowPortableTerminal: {
			Label: Autoriser le terminal portable
			Tooltip: Désactivé, les terminaux portables ne peuvent pas ouvrir de terminaux à distance
		}
