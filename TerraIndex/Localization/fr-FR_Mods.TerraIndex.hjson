	TakeMissingHint: Sort des coffres ce qui manque à ton inventaire pour une fabrication (Maj : pour 10)
	TakeMissingStatus: Dans les coffres, absent de ton inventaire : {0}
	TerminalTitle: Terminal de stockage
	ConnectedChests: "{0} coffres · {1}/{2} libres · {3} % plein"
	WireStations: Stations sur le fil :
	NoWireStations: aucune (mets des stations d'artisanat sur le fil rouge)
	TerminalHint: Clic : une pile   Clic droit maintenu : quantité   Maj : coffre   Ctrl : recette
	TerminalHoldingHint: Clic sur un objet : en sortir {0}   Clic droit dans le vide : annuler
	Max: Max
	TerminalEmpty:
		'''
		Aucun objet.
		Relie le terminal et tes coffres avec le même fil rouge.
		'''
	DepositButton: Déposer
	DepositTitle: Déposer des objets dans les coffres
	DepositHint: À la fermeture, les objets vont dans les coffres par la porte du terminal.
	Done: Terminé
	DepositDone: Objets rangés dans les coffres.
	DepositNoSpace: Attention : les coffres connectés sont pleins. {0} objet(s) n'ont pas été envoyés et restent dans le terminal jusqu'à ce qu'il y ait de la place ou que tu les reprennes.
	DepositInUse: Un autre joueur utilise les emplacements de dépôt de ce terminal.
	QuickDepositButton: Tout déposer
	QuickDepositEmpty: Rien à déposer (la barre d'accès rapide, les pièces, les munitions et les favoris sont gardés).
	QuickDepositNoSpace: Les coffres connectés sont pleins : {0} objet(s) t'ont été rendus.
	SortBy: Tri : {0}
	SortName: Nom
	SortAmount: Quantité
	SortRarity: Rareté
	SortMod: Mod
	RemoteLinked: Terminal portable lié à ce terminal.
	RemoteNotLinked: Non lié. Tiens-le et fais un clic droit sur un terminal pour les lier.
	RemoteLinkedTo: Lié à un terminal à {0} blocs
	RemoteDisabled: Le terminal portable est désactivé sur ce serveur.
	HowToObtain: Comment l'obtenir
	NoSources:
		'''
		Aucune source connue : il se trouve probablement dans des coffres, en pêchant
		ou dans le monde (en cassant des blocs, en secouant des arbres, etc.).
		'''
	MoreAbove: "{0} de plus au-dessus (molette)"
	MoreBelow: "{0} de plus en dessous (molette)"
	SoldBy: Vendu par {0} : {1}
	SoldByFree: Vendu par {0}
	DroppedBy: Lâché par {0} ({1})
	FoundInside: Dans {0} ({1})
	AnyEnemy: n'importe quel ennemi
	SpawnsIn: Se trouve dans : {0}
	Page: Page {0} / {1}  ({2} objets)
	Platinum: "{0} platine"
	Gold: "{0} or"
	Silver: "{0} argent"
	Copper: "{0} cuivre"
	FoundIn: "{0} : trouvé dans {1} coffre(s)."
	Blocks: "{0} blocs"
	RecipesButton: Recettes
	HelpTerminal:
		'''
		Écris dans la recherche pour filtrer les objets (@mod filtre par mod).
		Clic gauche sur un objet : en sortir une pile (elle sort par la porte).
		Clic droit maintenu sur un objet : choisir une quantité, puis clic gauche pour la sortir.
		Clic droit dans le vide : abandonner la quantité choisie.
		Maj + clic : illuminer les coffres qui le contiennent.
		Ctrl + clic : ses recettes, dans l'index à côté du terminal.
		Recettes : ouvrir ou fermer l'index des recettes à côté du terminal.
		Tout déposer : ton inventaire va dans les coffres
		(sauf la barre d'accès rapide, les pièces, les munitions et les favoris).
		Déposer : des emplacements qui vont dans les coffres à la fermeture.
		Le terminal et les coffres doivent être sur le même fil rouge.
		Les icônes au-dessus des objets : les stations d'artisanat sur le fil ; elles comptent pour fabriquer avec les coffres.
		'''
	HelpIndex:
		'''
		Clic gauche sur un objet : comment le fabriquer. Clic droit : à quoi il sert.
		Molette sur une recette : la suivante. Retour : l'objet précédent.
		Ingrédients : vert = dans ton inventaire, bleu = dans les coffres d'un terminal, rouge = manquant.
		Arbre : tout le nécessaire jusqu'aux matériaux de base ; il peut devenir ton objectif.
		Près d'un terminal, tu peux fabriquer directement avec ses coffres ou sortir ce qui te manque.
		Touches (Paramètres > Commandes) : ouvrir l'index, les recettes ou les utilisations de l'objet sous la souris.
		Clic molette sur un objet : sortir une pile des coffres d'un terminal (près du dernier ouvert).
		'''
	TipPlaced: Terminal posé ! Relie-le à tes coffres avec du fil rouge (posé avec : {0}, vendu par : {1}), puis fais un clic droit dessus.
	TipOpened: Astuce : survole le bouton ? pour voir les commandes du terminal. « Recettes » ouvre l'index des recettes à côté.
	TeleporterNotLinked: Ce téléporteur n'est relié à aucun autre. Tiens un Lieur de téléporteurs et fais un clic droit dessus, puis sur un autre.
	TeleporterPicked: Téléporteur choisi. Fais un clic droit sur un autre pour les relier.
	TeleporterCancelled: Liaison annulée.
	TeleporterLinked: Téléporteurs reliés (à {0} blocs).
	TeleporterPickedTooltip: Un téléporteur est choisi : clic droit sur un autre pour les relier
}

Items: {
	WirelessTeleporterItem: {
		DisplayName: Téléporteur sans fil
		Tooltip:
			'''
			Pas besoin de câble : relie-le à un autre avec le Lieur de téléporteurs
			Clic droit pour te téléporter vers celui qui est relié
			On peut se tenir dessus
			'''
	}

	TeleporterLinkerItem: {
		DisplayName: Lieur de téléporteurs
		Tooltip:
			'''
			Tiens-le et fais un clic droit sur un téléporteur sans fil, puis sur un autre, pour les relier
			Refais un clic droit sur le premier pour annuler
			'''
	}

	TerminalItem: {
		DisplayName: Terminal
		Tooltip:
			'''
			Doit être posé sur un mur de fond
			Relie-le à tes coffres avec du fil rouge et fais un clic droit dessus pour chercher des objets
			Les objets que tu sors sortent par sa porte
			'''
	}

	RemoteTerminalItem: {
		DisplayName: Terminal portable
		Tooltip:
			'''
			Tiens-le et fais un clic droit sur un terminal pour les lier
			Utilise-le pour ouvrir le terminal lié de n'importe où
			Les objets que tu sors apparaissent à côté de toi
			'''
	}

	BlueprintItem: {
		DisplayName: Plan
		Tooltip:
			'''
			Clic droit pour choisir une maison et son matériau
			Clic gauche pour la construire là où est l'aperçu
			Les matériaux viennent de ton inventaire ; aucune station d'artisanat requise
			'''
	}

	RadioItem: {
		DisplayName: Radio
		Tooltip:
			'''
			Joue quelque chose de temps en temps
			Clic droit pour l'allumer ou l'éteindre
			'''
	}
}

NPCs: {
	Apothecary: {
		DisplayName: Apothicaire
		Bestiary: Un brasseur itinérant qui vend des potions de combat pour presque rien. Personne ne sait comment il tient ses prix.
		Census.SpawnCondition: Après avoir vaincu l'Œil de Cthulhu

		Dialogue: {
			0: Chaque potion coûte une pièce d'argent. Ne demande pas d'où viennent les ingrédients.
			1: Affronter un boss sans Peau de fer ? Audacieux.
			2: Colère et Rage ensemble. Fais-moi confiance.
			3: Si quelque chose explose, ce n'est pas ma faute.
		}

		TownNPCMood: {
			// Content: Estoy feliz.
			// NoHome: Detesto no tener un hogar.
			// FarFromHome: Estoy demasiado lejos de casa.
			// LoveSpace: Me encanta tener tanto espacio.
			// DislikeCrowded: No me gusta tener tan poco espacio.
			// HateCrowded: Detesto tener poco espacio.
			// LoveBiome: Adoro el biomedio {BiomeName}.
			// LikeBiome: Me gusta el biomedio {BiomeName}.
			// DislikeBiome: No me gusta el biomedio {BiomeName}.
			// LoveNPC: Adoro a {NPCName}.
			// LikeNPC: Me gusta {NPCName}.
			// DislikeNPC: "{NPCName} no me cae nada bien."
			// HateNPC: Detesto a {NPCName}.
			// LikeNPC_Princess: Me gusta {NPCName}.
			// Princess_LovesNPC: Me gusta {NPCName}.
		}
	}
}

