Keybinds: {
	ToggleBrowser.DisplayName: Ouvrir/fermer l'index des recettes
	ShowRecipes.DisplayName: Recettes de l'objet sous la souris
	ShowUses.DisplayName: Utilisations de l'objet sous la souris
}

