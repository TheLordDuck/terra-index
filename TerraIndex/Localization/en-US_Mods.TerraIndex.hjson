Keybinds: {
	ToggleBrowser.DisplayName: Toggle recipe index
	ShowRecipes.DisplayName: Show recipes of hovered item
	ShowUses.DisplayName: Show uses of hovered item
}

UI: {
	Title: Recipe Index
	SearchHint: Search... (@mod to filter by mod)
	CategoryAll: All items
	CategoryWeapons: Weapons and ammo
	CategoryTools: Tools
	CategoryArmor: Armor and vanity
	CategoryAccessories: Accessories
	CategoryPlaceable: Blocks, walls and furniture
	CategoryConsumables: Potions and consumables
	CategoryMaterials: Materials
	CategoryMisc: Miscellaneous
	CategoryUpgrades: Next upgrades (for the bosses you have beaten)
	InChests: In your chests: {0}
	DummyDamage: Last {0}s: {1} damage ({2} DPS)
	DummyTotal: Total: {0} damage
	NoResults: No items match your search.
	UpgradesButton: Next upgrades ({0})
	UpgradesEmpty: Nothing to suggest: no craftable gear beats yours among what the bosses you have beaten let you make. Beat another boss, or carry the weapons you use.
	Hint:
		'''
		Left click an item: how to craft it.
		Right click: recipes that use it.
		Mouse wheel over this panel: switch recipe.
		'''
	Back: Back
	RecipesTab: Recipes ({0})
	UsesTab: Uses ({0})
	NoRecipes: This item cannot be crafted.
	NoUses: This item is not used in any recipe.
	Result: Result
	Ingredients: Ingredients
	Stations: Crafting station
	ByHand: By hand (no station needed)
	Conditions: Conditions
	TreeTab: Tree
	TreeTitle: Crafting tree
	TreeRecipe: (recipe {0} of {1})
	TreeHave: (have {0})
	TreeMissing: Missing materials
	TreeComplete: You have every material.
	TreeStations: Crafting stations
	SetGoal: Set as goal
	RemoveGoal: Remove goal
	GoalTitle: Goal: {0}
	GoalReady: You have everything to craft {0}!
	GoalReadyShort: Ready to craft!
	GoalMore: +{0} more
	GoalStep: Craft {0} x {1}
	GoalStepChests: Craft {0} x {1} (chests)
	GoalNeedsStation: Next step needs: {0}
	GoalCrafted: Crafted {0} x {1}.
	TakeNeedsTerminal: Middle click takes items out of the chests of the last terminal you opened, while you are near it.
	TakeNotStored: "{0} isn't in the terminal's chests."
	BlueprintTitle: Blueprints
	BlueprintSmallHouse: Small house
	BlueprintTwoFloors: Two-floor house
	BlueprintTower: Tower
	BlueprintArena: Boss arena
	BlueprintMedieval: Medieval house
	BlueprintCastle: Castle
	BlueprintPagoda: Pagoda
	BlueprintWizardTower: Wizard tower
	BlueprintWorkshop: Craftsman's house
	BlueprintTreeVillage: Tree village
	BlueprintBigTree: Big tree
	BlueprintThickTree: Thick tree
	BlueprintHerbGarden: Herb garden
	BlueprintFishingPond: Fishing pond
	BlueprintBuffArena: Arena with buffs
	BlueprintTabBuildings: Buildings
	BlueprintTabNpcs: Town NPCs
	HappinessTitle: Who will live here? Pick a town NPC to see where they are happiest:
	HappinessPick: Click an NPC's head.
	HappinessLove: Loves:
	HappinessLike: Likes:
	HappinessDislike: Dislikes:
	HappinessHate: Hates:
	HappinessNone: No preferences.
	HappinessCrowd: All of them are happier with no more than 2 other NPCs living close by.
	BlueprintMaterial: Material:
	BlueprintPickMaterial: Pick a material.
	BlueprintNoMaterials: No materials found.
	BlueprintFree: Free: building takes no materials.
	BlueprintPlace: Place
	BlueprintHint: Hold the blueprint: left click builds the house where its preview is, right click opens this catalog. Every room is valid housing for an NPC.
	BlueprintPreviewHint: Left click: build here   Right click: blueprints
	BuildBlocked: Something is in the way (red tiles): clear it first.
	BuildDone: "{0} built!"
	BuildFailed: Couldn't build there.
	GoalCollapse: Fold (drag the title to move the panel)
	GoalExpand: Unfold (drag the title to move the panel)
	CompareAdd: + Compare
	CompareOpen: Compare ({0})
	CompareTitle: Comparison
	CompareRemoveHint: Right click an item to remove it
	CompareDamage: Damage
	CompareCrit: Critical chance
	CompareUseTime: Use time (ticks)
	CompareKnockback: Knockback
	CompareMana: Mana cost
	CompareVelocity: Projectile speed
	ComparePickaxe: Pickaxe power
	CompareAxe: Axe power
	CompareHammer: Hammer power
	CompareDefense: Defense
	CompareValue: Sell value
	CompareEffects: Effects
	CraftButton: Craft
	CraftCanMake: With your chests and inventory you can make {0}
	CraftNoIngredients: Not enough ingredients in the chests and your inventory
	CraftNoStation: Missing crafting station (nearby or on the terminal's wire)
	CraftNoConditions: Conditions not met here
	Crafted: Crafted {0} x {1} with the terminal.
	CraftFailed: The chests and your inventory no longer have the ingredients.
	TakeMissing: Take missing
	TakeMissingHint: Takes out of the chests what your inventory lacks for one craft (Shift: for 10)
	TakeMissingStatus: In the chests, missing from your inventory: {0}
	TerminalTitle: Storage Terminal
	ConnectedChests: "{0} chests · {1}/{2} free · {3}% full"
	WireStations: Stations on the wire:
	NoWireStations: none (put crafting stations on the red wire)
	TerminalHint: Click: a stack   Hold right click: amount   Shift: chest   Ctrl: recipe
	TerminalHoldingHint: Click an item: take out {0}   Right click empty space: cancel
	Max: Max
	TerminalEmpty:
		'''
		No items.
		Connect the terminal and your chests with the same red wire.
		'''
	DepositButton: Deposit items
	DepositTitle: Deposit items into the chests
	DepositHint: When you close this, the items go into the chests through the terminal's door.
	Done: Done
	DepositDone: Items stored in the chests.
	DepositNoSpace: Warning: the connected chests are full. {0} item(s) were not sent and stay in the terminal until there is room or you take them out.
	DepositInUse: Another player is using this terminal's deposit slots.
	QuickDepositButton: Deposit all
	QuickDepositEmpty: Nothing to deposit (the hotbar, coins, ammo and favorited items are kept).
	QuickDepositNoSpace: The connected chests are full: {0} item(s) were given back to you.
	SortBy: Sort: {0}
	SortName: Name
	SortAmount: Amount
	SortRarity: Rarity
	SortMod: Mod
	RemoteLinked: Portable terminal linked to this terminal.
	RemoteNotLinked: Not linked. Hold it and right click a terminal to link them.
	RemoteLinkedTo: Linked to a terminal {0} blocks away
	RemoteDisabled: The portable terminal is disabled on this server.
	HowToObtain: How to obtain
	NoSources:
		'''
		No known source: it is probably found in chests, by fishing,
		or in the world (breaking tiles, shaking trees, etc.).
		'''
	MoreAbove: "{0} more above (mouse wheel)"
	MoreBelow: "{0} more below (mouse wheel)"
	SoldBy: Sold by {0}: {1}
	SoldByFree: Sold by {0}
	DroppedBy: Dropped by {0} ({1})
	FoundInside: Inside {0} ({1})
	AnyEnemy: any enemy
	SpawnsIn: Found in: {0}
	Page: Page {0} / {1}  ({2} items)
	Platinum: "{0} platinum"
	Gold: "{0} gold"
	Silver: "{0} silver"
	Copper: "{0} copper"
	FoundIn: "{0}: found in {1} chest(s)."
	Blocks: "{0} blocks"
	RecipesButton: Recipes
	HelpTerminal:
		'''
		Type in the search box to filter the items (@mod filters by mod).
		Left click an item: take out a stack (it comes out of the door).
		Hold right click on an item: pick an amount, then left click to take it out.
		Right click empty space: drop the picked amount.
		Shift + click: light up the chests holding it.
		Ctrl + click: its recipes, in the index next to the terminal.
		Recipes: open or close the recipe index next to the terminal.
		Deposit all: your inventory goes into the chests
		(not the hotbar, coins, ammo or favorited items).
		Deposit items: slots that go into the chests when you close them.
		The terminal and the chests must be on the same red wire.
		The icons above the items: crafting stations on the wire; they count for crafting from the chests.
		'''
	HelpIndex:
		'''
		Left click an item: how to craft it. Right click: what it is used in.
		Mouse wheel over a recipe: the next one. Back: the previous item.
		Ingredients: green = in your inventory, blue = in a terminal's chests, red = missing.
		Tree: everything needed down to the base materials; it can be set as your goal.
		Near a terminal you can craft straight from its chests, or take out what you lack.
		Keys (Settings > Controls): open the index, recipes or uses of the item under the mouse.
		Middle click an item: take a stack out of a terminal's chests (near the last one you opened).
		'''
	TipPlaced: Terminal placed! Connect it to your chests with red wire (placed with the {0}, sold by the {1}), then right click it.
	TipOpened: Tip: hover over the ? button to see the terminal's controls. "Recipes" opens the recipe index next to it.
	TeleporterNotLinked: This teleporter isn't linked. Hold a Teleporter Linker and right click it, then another one.
	TeleporterPicked: Teleporter picked. Right click another one to link them.
	TeleporterCancelled: Link cancelled.
	TeleporterLinked: Teleporters linked ({0} blocks apart).
	TeleporterPickedTooltip: A teleporter is picked: right click another one to link them
}

Items: {
	WirelessTeleporterItem: {
		DisplayName: Wireless Teleporter
		Tooltip:
			'''
			Needs no wire: link it to another one with the Teleporter Linker
			Right click it to teleport to the linked one
			You can stand on it
			'''
	}

	TeleporterLinkerItem: {
		DisplayName: Teleporter Linker
		Tooltip:
			'''
			Hold it and right click a wireless teleporter, then another one, to link them
			Right click the first one again to cancel
			'''
	}

	TerminalItem: {
		DisplayName: Terminal
		Tooltip:
			'''
			Must be placed on a background wall
			Connect it to your chests with red wire and right click it to search for items
			Items you take out come out of its door
			'''
	}

	RemoteTerminalItem: {
		DisplayName: Portable Terminal
		Tooltip:
			'''
			Hold it and right click a terminal to link them
			Use it to open the linked terminal from anywhere
			Items you take out appear next to you
			'''
	}

	BlueprintItem: {
		DisplayName: Blueprint
		Tooltip:
			'''
			Right click to choose a house and its material
			Left click to build it where the preview is
			Materials come from your inventory; no crafting station needed
			'''
	}

	RadioItem: {
		DisplayName: Radio
		Tooltip:
			'''
			Plays something every now and then
			Right click it to turn it on or off
			'''
	}
}

NPCs: {
	Apothecary: {
		DisplayName: Apothecary
		Bestiary: A wandering brewer who sells battle potions for next to nothing. Nobody knows how the prices stay so low.
		Census.SpawnCondition: After defeating the Eye of Cthulhu

		Dialogue: {
			0: Every potion is one silver. Don't ask where the ingredients come from.
			1: Fighting a boss without Ironskin? Bold.
			2: Wrath and Rage together. Trust me.
			3: If something explodes, it wasn't my fault.
		}

		TownNPCMood: {
			Content: Estoy feliz.
			NoHome: Detesto no tener un hogar.
			FarFromHome: Estoy demasiado lejos de casa.
			LoveSpace: Me encanta tener tanto espacio.
			DislikeCrowded: No me gusta tener tan poco espacio.
			HateCrowded: Detesto tener poco espacio.
			LoveBiome: Adoro el biomedio {BiomeName}.
			LikeBiome: Me gusta el biomedio {BiomeName}.
			DislikeBiome: No me gusta el biomedio {BiomeName}.
			LoveNPC: Adoro a {NPCName}.
			LikeNPC: Me gusta {NPCName}.
			DislikeNPC: "{NPCName} no me cae nada bien."
			HateNPC: Detesto a {NPCName}.
			LikeNPC_Princess: Me gusta {NPCName}.
			Princess_LovesNPC: Me gusta {NPCName}.
		}
	}
}

Tiles: {
	WirelessTeleporterTile.MapEntry: Wireless Teleporter
	TerminalTile.MapEntry: Terminal
	RadioTile.MapEntry: Radio
}

Configs: {
	ClientConfig: {
		DisplayName: Terra Index (your settings)

		Headers: {
			Goal: Crafting goal
			Terminal: Storage terminal
			Effects: Effects
		}

		ShowGoalPanel: {
			Label: Show the goal panel
			Tooltip: The on-screen list of materials still missing for your crafting goal
		}

		GoalPanelRows: {
			Label: Goal panel: materials shown
			Tooltip: The rest are summed up as "+N more"
		}

		DefaultSort: {
			Label: Default terminal sort
			Tooltip: Order of the terminal's items when you enter a world
		}

		HighlightSeconds: {
			Label: Chest highlight duration (seconds)
			Tooltip: How long chests glow after Shift + clicking an item in the terminal
		}

		QuickDepositHotbar: {
			Label: Include the hotbar in "Deposit all"
			Tooltip: Favorited items, coins and ammo are always kept
		}

		FocusTerminalSearch: {
			Label: Type in the terminal's search box when it opens
			Tooltip: While typing, the mod's keys (N, [ and ]) don't work
		}

		ChestCountTooltip: {
			Label: Show how many are in your chests in item tooltips
			Tooltip: While a terminal is in reach (or you carry its portable terminal)
		}

		ChestEffects: {
			Label: Chest effects
			Tooltip: Sparks, light and a sound on the chests items go into or come out of
		}

		DummyDamageMeter: {
			Label: Damage meter on the Target Dummy
			Tooltip: Damage it took in the last 5 and 10 seconds, and the damage per second
		}
	}

	ServerConfig: {
		DisplayName: Terra Index (server)

		TerminalPriceGold: {
			Label: Terminal price (gold)
			Tooltip: What the Steampunker charges for the Terminal. 100 gold = 1 platinum
		}

		TerminalReach: {
			Label: Terminal reach (blocks)
			Tooltip: How far players can walk away from a terminal before its panel closes
		}

		MaxWireTiles: {
			Label: Maximum wire network size
			Tooltip: Red wire tiles walked from a terminal looking for chests. Lower it if huge networks cause lag
		}

		AllowPortableTerminal: {
			Label: Allow the Portable Terminal
			Tooltip: When off, portable terminals can't open terminals from far away
		}
	}

	TerminalSort: {
		Name: {
			Label: Name
			Tooltip: ""
		}

		Amount: {
			Label: Amount
			Tooltip: ""
		}

		Rarity: {
			Label: Rarity
			Tooltip: ""
		}

		Mod: {
			Label: Mod
			Tooltip: ""
		}

		Tooltip: ""
	}
}
