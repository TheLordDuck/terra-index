	Platinum: "{0} di platino"
	Gold: "{0} d'oro"
	Silver: "{0} d'argento"
	Copper: "{0} di rame"
	FoundIn: "{0}: trovato in {1} cassa/e."
	Blocks: "{0} blocchi"
	RecipesButton: Ricette
	HelpTerminal:
		'''
		Scrivi nella ricerca per filtrare gli oggetti (@mod filtra per mod).
		Clic sinistro su un oggetto: prendine una pila (esce dalla porta).
		Tieni premuto il destro su un oggetto: scegli una quantità, poi prendila con il sinistro.
		Clic destro nel vuoto: annulla la quantità scelta.
		Maiusc + clic: illumina le casse che lo contengono.
		Ctrl + clic: le sue ricette, nell'indice accanto al terminale.
		Ricette: apri o chiudi l'indice delle ricette accanto al terminale.
		Deposita tutto: il tuo inventario va nelle casse
		(tranne barra rapida, monete, munizioni e preferiti).
		Deposita: slot che vanno nelle casse quando li chiudi.
		Il terminale e le casse devono essere sullo stesso filo rosso.
		Le icone sopra gli oggetti: stazioni di creazione sul filo; contano per creare dalle casse.
		'''
	HelpIndex:
		'''
		Clic sinistro su un oggetto: come crearlo. Clic destro: a cosa serve.
		Pulsante classe (accanto alla ricerca): solo le armi di una classe; clic sinistro la successiva, clic destro la precedente.
		Guida di Calamity (pulsante dorato): l'equipaggiamento consigliato dal wiki per la tua classe nella tua fase; il pulsante classe sceglie la classe.
		Rotellina su una ricetta: la successiva. Indietro: l'oggetto precedente.
		Ingredienti: verde = nell'inventario, blu = nelle casse di un terminale, rosso = mancante.
		Albero: tutto il necessario fino ai materiali di base; può diventare il tuo obiettivo.
		Vicino a un terminale puoi creare direttamente dalle sue casse o prendere ciò che ti manca.
		Tasti (Impostazioni > Controlli): apri l'indice, ricette o usi dell'oggetto sotto il mouse.
		Clic centrale su un oggetto: prendine una pila dalle casse di un terminale (vicino all'ultimo aperto).
		'''
	TipPlaced: Terminale piazzato! Collegalo alle tue casse con filo rosso (si posa con: {0}, venduto da: {1}), poi fai clic destro su di esso.
	TipOpened: Suggerimento: passa il mouse sul pulsante ? per vedere i comandi del terminale. "Ricette" apre l'indice delle ricette accanto.
	TeleporterNotLinked: Questo teletrasporto non ha un canale. Tieni in mano un Collegatore di teletrasporti e fai clic destro su di esso per sceglierne uno.
	TeleporterAlone: Nessun altro teletrasporto è sul canale {0}. Mettine un altro su quel canale con il Collegatore.
	TeleporterChannel: Canale {0}
	TeleporterNoChannel: Nessun canale
	TeleporterMenuTitle: Canale del teletrasporto
	TeleporterNewChannel: Nuovo canale
	TeleporterChannelCount: Canale {0} — teletrasporti: {1}
	TeleporterNoChannels: Ancora nessun canale.
	TeleporterClearChannel: Togli il canale
	TeleporterChannelSet: Teletrasporto sul canale {0}.
	TeleporterChannelCleared: Teletrasporto senza canale.
}

Items: {
	WirelessTeleporterItem: {
		DisplayName: Teletrasporto senza fili
		Tooltip:
			'''
			Non servono cavi: dagli un canale con il Collegatore di teletrasporti
			Clic destro per teletrasportarti al successivo del suo canale
			Ci si può stare sopra
			'''
	}

	TeleporterLinkerItem: {
		DisplayName: Collegatore di teletrasporti
		Tooltip:
			'''
			Tienilo in mano e fai clic destro su un teletrasporto senza fili per sceglierne il canale
			Un canale nuovo o uno già usato: i teletrasporti sullo stesso canale ti portano dall'uno all'altro
			'''
	}

	TerminalItem: {
		DisplayName: Terminale
		Tooltip:
			'''
			Va piazzato su un muro di sfondo
			Collegalo alle tue casse con filo rosso e fai clic destro per cercare oggetti
			Gli oggetti che prendi escono dalla sua porta
			'''
	}

	RemoteTerminalItem: {
		DisplayName: Terminale portatile
		Tooltip:
			'''
			Tienilo in mano e fai clic destro su un terminale per collegarli
			Usalo per aprire il terminale collegato da ovunque
			Gli oggetti che prendi appaiono accanto a te
			'''
	}

	BlueprintItem: {
		DisplayName: Progetto
		Tooltip:
			'''
			Clic destro per scegliere una casa e il suo materiale
			Clic sinistro per costruirla dov'è l'anteprima
			I materiali vengono dall'inventario; nessuna stazione di creazione necessaria
			'''
	}

	RadioItem: {
		DisplayName: Radio
		Tooltip:
			'''
			Ogni tanto suona qualcosa
			Clic destro per accenderla o spegnerla
			'''
	}
}

NPCs: {
	Apothecary: {
		DisplayName: Speziale
		Bestiary: Un alchimista errante che vende pozioni da battaglia quasi gratis. Nessuno sa come tenga i prezzi così bassi.
		Census.SpawnCondition: Dopo aver sconfitto l'Occhio di Cthulhu

		Dialogue: {
			0: Ogni pozione costa un argento. Non chiedere da dove vengono gli ingredienti.
			1: Affrontare un boss senza Pelle di ferro? Coraggioso.
			2: Collera e Rabbia insieme. Fidati.
			3: Se qualcosa esplode, non è colpa mia.
		}

		TownNPCMood: {
			// Content: Estoy feliz.
			// NoHome: Detesto no tener un hogar.
			// FarFromHome: Estoy demasiado lejos de casa.
			// LoveSpace: Me encanta tener tanto espacio.
			// DislikeCrowded: No me gusta tener tan poco espacio.
			// HateCrowded: Detesto tener poco espacio.
			// LoveBiome: Adoro el biomedio {BiomeName}.
			// LikeBiome: Me gusta el biomedio {BiomeName}.
