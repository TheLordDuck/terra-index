	ToggleBrowser.DisplayName: Apri/chiudi l'indice delle ricette
	ShowRecipes.DisplayName: Ricette dell'oggetto sotto il mouse
	ShowUses.DisplayName: Usi dell'oggetto sotto il mouse
}

