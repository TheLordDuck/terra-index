	NoWireStations: ninguna (pon estaciones de fabricación en el cable rojo)
	TerminalHint: Clic: una pila   Mantén clic dcho.: cantidad   Mayús: cofre   Ctrl: receta
	TerminalHoldingHint: Clic en un objeto: sacar {0}   Clic dcho. en un hueco: cancelar
	Max: Máx.
	TerminalEmpty:
		'''
		No hay objetos.
		Conecta la terminal y los cofres con el mismo cable rojo.
		'''
	DepositButton: Dejar objetos
	DepositTitle: Dejar objetos en los cofres
	DepositHint: Al cerrar, los objetos entran en los cofres por la puerta de la terminal.
	Done: Listo
	DepositDone: Objetos guardados en los cofres.
	DepositNoSpace: Aviso: los cofres conectados están llenos. {0} objeto(s) no se han enviado y se quedan en la terminal hasta que haya sitio o los saques.
	DepositInUse: Otro jugador está usando las casillas de esta terminal.
	QuickDepositButton: Dejar todo
	QuickDepositEmpty: No hay nada que dejar (la barra rápida, las monedas, la munición y los favoritos se quedan).
	QuickDepositNoSpace: Los cofres conectados están llenos: se te han devuelto {0} objeto(s).
	SortBy: Orden: {0}
	SortName: Nombre
	SortAmount: Cantidad
	SortRarity: Rareza
	SortMod: Mod
	RemoteLinked: Terminal portátil vinculada a esta terminal.
	RemoteNotLinked: Sin vincular. Sostenla y haz clic derecho en una terminal para vincularlas.
	RemoteLinkedTo: Vinculada a una terminal a {0} bloques
	RemoteDisabled: La terminal portátil está desactivada en este servidor.
	HowToObtain: Cómo se consigue
	NoSources:
		'''
		No hay una fuente conocida: probablemente se encuentra en cofres, pescando
		o en el mundo (rompiendo bloques, sacudiendo árboles, etc.).
		'''
	MoreAbove: "{0} más arriba (rueda del ratón)"
	MoreBelow: "{0} más abajo (rueda del ratón)"
	SoldBy: Lo vende {0}: {1}
	SoldByFree: Lo vende {0}
	DroppedBy: Lo suelta {0} ({1})
	FoundInside: Sale de {0} ({1})
	AnyEnemy: cualquier enemigo
	SpawnsIn: Aparece en: {0}
	Page: Página {0} / {1}  ({2} objetos)
	Platinum: "{0} de platino"
	Gold: "{0} de oro"
	Silver: "{0} de plata"
	Copper: "{0} de cobre"
	FoundIn: "{0}: encontrado en {1} cofre(s)."
	Blocks: "{0} bloques"
	RecipesButton: Recetas
	HelpTerminal:
		'''
		Escribe en el buscador para filtrar los objetos (@mod filtra por mod).
		Clic izquierdo en un objeto: saca una pila (sale por la puerta).
		Mantén clic derecho en un objeto: elige una cantidad y luego sácala con clic izquierdo.
		Clic derecho en un hueco vacío: suelta la cantidad elegida.
		Mayús + clic: ilumina los cofres que lo tienen.
		Ctrl + clic: sus recetas, en el índice junto al terminal.
		Recetas: abre o cierra el índice de recetas junto al terminal.
		Dejar todo: tu inventario va a los cofres
		(no la barra rápida, las monedas, la munición ni los favoritos).
		Dejar objetos: casillas que van a los cofres al cerrarlas.
		El terminal y los cofres deben estar en el mismo cable rojo.
		Los iconos sobre los objetos: estaciones de fabricación en el cable; cuentan para fabricar desde los cofres.
		'''
	HelpIndex:
		'''
		Clic izquierdo en un objeto: cómo se fabrica. Clic derecho: en qué se usa.
		Rueda del ratón sobre una receta: la siguiente. Atrás: el objeto anterior.
		Ingredientes: verde = en tu inventario, azul = en los cofres de un terminal, rojo = te falta.
		Árbol: todo lo necesario hasta los materiales básicos; se puede fijar como objetivo.
		Cerca de un terminal puedes fabricar directamente desde sus cofres, o sacar lo que te falta.
		Teclas (Ajustes > Controles): abrir el índice, ver recetas o usos del objeto bajo el ratón.
		Clic central en un objeto: saca una pila de los cofres de un terminal (cerca del último que abriste).
		'''
	TipPlaced: ¡Terminal colocado! Conéctalo a tus cofres con cable rojo (se pone con: {0}, lo vende: {1}) y haz clic derecho en él.
	TipOpened: Consejo: pasa el ratón por el botón ? para ver los controles del terminal. "Recetas" abre el índice de recetas a su lado.
}

Items: {
	TerminalItem: {
		DisplayName: Terminal
		Tooltip:
			'''
			Se coloca sobre una pared de fondo
			Conéctala con cable rojo a tus cofres y haz clic derecho para buscar objetos
			Los objetos que saques salen por su puerta
			'''
	}

	RemoteTerminalItem: {
		DisplayName: Terminal portátil
		Tooltip:
			'''
			Sostenla y haz clic derecho en una terminal para vincularlas
			Úsala para abrir la terminal vinculada desde cualquier lugar
			Los objetos que saques aparecen a tu lado
			'''
	}

	BlueprintItem: {
		DisplayName: Plano
		Tooltip:
			'''
			Clic derecho para elegir una casa y su material
			Clic izquierdo para construirla donde está la vista previa
			Los materiales salen de tu inventario; no hace falta estación de fabricación
			'''
	}

	RadioItem: {
		DisplayName: Radio
		Tooltip:
			'''
			De vez en cuando suena algo
			Haz clic derecho para encenderla o apagarla
			'''
	}
}

Tiles: {
	TerminalTile.MapEntry: Terminal
	RadioTile.MapEntry: Radio
}

Configs: {
	ClientConfig: {
		DisplayName: Terra Index (tus ajustes)

		Headers: {
			Goal: Objetivo de crafteo
			Terminal: Terminal de almacenamiento
			Effects: Efectos
		}

		ShowGoalPanel: {
			Label: Mostrar el panel del objetivo
			Tooltip: La lista en pantalla con los materiales que te faltan para tu objetivo
		}

		GoalPanelRows: {
			Label: Panel del objetivo: materiales mostrados
			Tooltip: El resto se resume como "+N más"
		}

		DefaultSort: {
			Label: Orden por defecto del terminal
			Tooltip: Orden de los objetos del terminal al entrar en un mundo
		}

		HighlightSeconds: {
			Label: Duración del resaltado de cofres (segundos)
			Tooltip: Cuánto tiempo brillan los cofres tras Mayús + clic en un objeto del terminal
		}

		QuickDepositHotbar: {
			Label: Incluir la barra rápida en "Dejar todo"
			Tooltip: Los favoritos, las monedas y la munición siempre se quedan
		}

		FocusTerminalSearch: {
			Label: Escribir en el buscador del terminal al abrirlo
			Tooltip: Mientras escribes, las teclas del mod (N, [ y ]) no funcionan
		}

		ChestCountTooltip: {
			Label: Mostrar en los tooltips cuántos hay en tus cofres
			Tooltip: Mientras tengas un terminal al alcance (o lleves su terminal portátil)
		}

		ChestEffects: {
			Label: Efectos en los cofres
			Tooltip: Chispas, luz y un sonido en los cofres de los que salen o a los que entran objetos
		}
	}

	ServerConfig: {
		DisplayName: Terra Index (servidor)

		TerminalPriceGold: {
			Label: Precio de la terminal (oro)
			Tooltip: Lo que cobra el Steampunker por la Terminal. 100 de oro = 1 de platino
		}

		TerminalReach: {
			Label: Alcance de la terminal (bloques)
			Tooltip: Cuánto pueden alejarse los jugadores de una terminal antes de que se cierre su panel
		}

		MaxWireTiles: {
			Label: Tamaño máximo de la red de cable
			Tooltip: Casillas de cable rojo que se recorren desde una terminal buscando cofres. Bájalo si las redes enormes causan lag
		}

		AllowPortableTerminal: {
			Label: Permitir la Terminal portátil
			Tooltip: Si se desactiva, las terminales portátiles no pueden abrir terminales a distancia
		}
	}

	TerminalSort: {
		Name: {
			Label: Nombre
			// Tooltip: ""
		}

		Amount: {
			Label: Cantidad
			// Tooltip: ""
		}

		Rarity: {
			Label: Rareza
			// Tooltip: ""
		}

		Mod: {
			Label: Mod
			// Tooltip: ""
		}

		// Tooltip: ""
	}
